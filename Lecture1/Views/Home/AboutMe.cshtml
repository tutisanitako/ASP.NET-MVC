                    <img src="~/img/tshirt-main.jpg" alt="ONE LIFE GRAPHIC T-SHIRT">
                </div>
            </div>

            <div class="product-info">
                <h1>ONE LIFE GRAPHIC T-SHIRT</h1>
                
                <div class="rating">
                    <div class="stars">★★★★☆</div>
                    <span>4.5/5</span>
                </div>

                <div class="price">
                    <span class="current-price">$260</span>
                    <span class="original-price">$300</span>
                    <span class="discount">-40%</span>
                </div>

                <p class="description">
                    This graphic t-shirt which is perfect for any occasion. Crafted from a soft and breathable fabric, it offers superior comfort and style.
                </p>

                <div class="color-selection">
                    <div class="section-title">Select Colors</div>
                    <div class="color-options">
                        <div class="color-option color-brown active"></div>
                        <div class="color-option color-green"></div>
                        <div class="color-option color-navy"></div>
                    </div>
                </div>

                <div class="size-selection">
                    <div class="section-title">Choose Size</div>
                    <div class="size-options">
                        <div class="size-option">Small</div>
                        <div class="size-option">Medium</div>
                        <div class="size-option active">Large</div>
                        <div class="size-option">X-Large</div>
                    </div>
                </div>

                <div class="quantity-cart">
                    <div class="quantity-selector">
