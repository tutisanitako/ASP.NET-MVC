<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ONE LIFE GRAPHIC T-SHIRT - Shop.co</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8f9fa;
            line-height: 1.6;
        }

        .header {
            background: #000;
            color: white;
            text-align: center;
            padding: 8px;
            font-size: 14px;
        }

        .header a {
            color: white;
            text-decoration: underline;
        }

        .navbar {
            background: white;
            padding: 15px 0;
            border-bottom: 1px solid #e5e5e5;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .nav-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            text-decoration: none;
            color: #333;
            font-weight: 500;
        }

        .search-box {
            display: flex;
            align-items: center;
            background: #f0f0f0;
            border-radius: 25px;
            padding: 8px 20px;
            width: 300px;
        }

        .search-box input {
            border: none;
            background: none;
            outline: none;
            flex: 1;
            padding: 5px;
        }

        .nav-icons {
            display: flex;
            gap: 15px;
        }

        .breadcrumb {
            padding: 20px 0;
            color: #666;
        }

        .breadcrumb a {
            color: #666;
            text-decoration: none;
        }

        .product-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            margin-bottom: 60px;
        }

        .product-images {
            display: flex;
            gap: 20px;
        }

        .thumbnails {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
        }

        .thumbnail.active {
            border-color: #333;
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .main-image {
            flex: 1;
            border-radius: 20px;
            overflow: hidden;
            background: #e5e5e5;
            aspect-ratio: 1;
        }

        .main-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-info h1 {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #333;
        }

        .rating {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .stars {
            color: #ffd700;
            font-size: 18px;
        }

        .price {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .current-price {
            font-size: 32px;
            font-weight: bold;
            color: #333;
        }

        .original-price {
            font-size: 24px;
            color: #999;
            text-decoration: line-through;
        }

        .discount {
            background: #ff4444;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 14px;
        }

        .description {
            color: #666;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .color-selection {
            margin-bottom: 30px;
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 15px;
            color: #333;
        }

        .color-options {
            display: flex;
            gap: 15px;
        }

        .color-option {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            border: 3px solid transparent;
            position: relative;
        }

        .color-option.active::after {
            content: '✓';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-weight: bold;
        }

        .color-brown { background: #8B7355; }
        .color-green { background: #4A5D23; }
        .color-navy { background: #2B3A67; }

        .size-selection {
            margin-bottom: 30px;
        }

        .size-options {
            display: flex;
            gap: 15px;
        }

        .size-option {
            padding: 12px 20px;
            border: 2px solid #e5e5e5;
            border-radius: 25px;
            cursor: pointer;
            background: white;
            color: #666;
            font-weight: 500;
        }

        .size-option.active {
            background: #333;
            color: white;
            border-color: #333;
        }

        .quantity-cart {
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 2px solid #e5e5e5;
            border-radius: 25px;
            padding: 5px;
        }

        .quantity-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: none;
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quantity-input {
            width: 60px;
            text-align: center;
            border: none;
            outline: none;
            font-size: 16px;
        }

        .add-to-cart {
            flex: 1;
            background: #333;
            color: white;
            border: none;
            border-radius: 25px;
            padding: 15px 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        .tabs {
            margin: 60px 0;
        }

        .tab-buttons {
            display: flex;
            border-bottom: 2px solid #e5e5e5;
            margin-bottom: 30px;
        }

        .tab-btn {
            padding: 15px 30px;
            border: none;
            background: none;
            font-size: 16px;
            cursor: pointer;
            color: #666;
            border-bottom: 3px solid transparent;
        }

        .tab-btn.active {
            color: #333;
            font-weight: 600;
            border-bottom-color: #333;
        }

        .reviews-section {
            margin-bottom: 40px;
        }

        .reviews-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .reviews-title {
            font-size: 24px;
            font-weight: bold;
        }

        .review-controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .write-review-btn {
            background: #333;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-bottom: 30px;
        }

        .review-card {
            border: 1px solid #e5e5e5;
            border-radius: 15px;
            padding: 25px;
            background: white;
        }

        .review-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .reviewer-name {
            font-weight: 600;
            color: #333;
        }

        .verified {
            color: #28a745;
            font-size: 14px;
        }

        .review-text {
            color: #666;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .review-date {
            color: #999;
            font-size: 14px;
        }

        .load-more {
            text-align: center;
            margin: 40px 0;
        }

        .load-more-btn {
            border: 2px solid #333;
            background: none;
            padding: 12px 30px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
        }

        .related-products {
            margin: 80px 0;
        }

        .related-title {
            text-align: center;
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 50px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }

        .product-card {
            text-align: center;
        }

        .product-image {
            width: 100%;
            aspect-ratio: 1;
            border-radius: 15px;
            overflow: hidden;
            margin-bottom: 15px;
            background: #e5e5e5;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-name {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .product-rating {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 5px;
            margin-bottom: 10px;
        }

        .product-price {
            display: flex;
            justify-content: center;
            gap: 10px;
            align-items: center;
        }

        .newsletter {
            background: #333;
            color: white;
            padding: 60px 0;
            border-radius: 30px;
            margin: 60px 0;
        }

        .newsletter-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

        .newsletter h2 {
            font-size: 48px;
            font-weight: bold;
            line-height: 1.2;
        }

        .newsletter-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .newsletter input {
            padding: 15px 20px;
            border-radius: 25px;
            border: none;
            outline: none;
        }

        .newsletter button {
            padding: 15px;
            background: white;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
        }

        .footer {
            background: white;
            padding: 60px 0 30px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: 2fr repeat(4, 1fr);
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-brand h3 {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .footer-brand p {
            color: #666;
            margin-bottom: 30px;
        }

        .social-icons {
            display: flex;
            gap: 15px;
        }

        .social-icon {
            width: 40px;
            height: 40px;
            background: #333;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .footer-section h4 {
            font-weight: 600;
            margin-bottom: 20px;
            text-transform: uppercase;
            font-size: 14px;
            letter-spacing: 1px;
        }

        .footer-section a {
            display: block;
            color: #666;
            text-decoration: none;
            margin-bottom: 10px;
        }

        .footer-bottom {
            border-top: 1px solid #e5e5e5;
            padding-top: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .payment-icons {
            display: flex;
            gap: 10px;
        }

        .payment-icon {
            width: 40px;
            height: 25px;
            background: #e5e5e5;
            border-radius: 5px;
        }

        /* Mobile Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 0 15px;
            }

            .nav-content {
                flex-direction: column;
                gap: 15px;
            }

            .nav-links {
                display: none;
            }

            .search-box {
                width: 100%;
                max-width: 400px;
            }

            .product-section {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .product-images {
                flex-direction: column-reverse;
            }

            .thumbnails {
                flex-direction: row;
                justify-content: center;
            }

            .product-info h1 {
                font-size: 28px;
            }

            .quantity-cart {
                flex-direction: column;
            }

            .reviews-grid {
                grid-template-columns: 1fr;
            }

            .newsletter-content {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .newsletter h2 {
                font-size: 32px;
            }

            .footer-content {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .footer-bottom {
                flex-direction: column;
                text-align: center;
            }

            .products-grid {
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
            }
        }

        @@media (max-width: 480px) {
            .current-price {
                font-size: 24px;
            }

            .original-price {
                font-size: 18px;
            }

            .size-options {
                flex-wrap: wrap;
            }

            .related-title {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        Sign up and get 20% off to your first order. <a href="#">Sign Up Now</a>
    </div>

    <!-- Navigation -->
    <nav class="navbar">
