@model Lecture10.Models.Customer
@{
    Layout = "_Layout";
    ViewBag.Title = "Edit Product";
}

<div class="container">
    <h1 class="page-title">@ViewBag.Title – @Model.Name</h1>

    <div class="form-container">
        @using (Html.BeginForm("Update", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(m => m.Id)

            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(m => m.Name)
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Code)
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Address)
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Phone)
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "Price with $" })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                </div>

                <!-- CHANGE IMAGE -->
                <div class="form-group">
                    <label>Change Product Image (optional)</label>
                    <input type="file" name="ImageFile" accept="image/*" class="form-control" />
                    <small class="form-text">Leave empty to keep current image</small>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div style="margin-top: 12px;">
                            <strong>Current Image:</strong><br />
                            <img src="/images/products/@Model.ImagePath"
                                 alt="Current"
                                 style="width: 120px; height: 120px; object-fit: cover; border-radius: 10px; border: 3px solid #f0f0f0;" />
                        </div>
                    }
                </div>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            </div>
        }
    </div>
</div>