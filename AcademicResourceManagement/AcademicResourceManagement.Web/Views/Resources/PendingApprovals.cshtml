@model IEnumerable<AcademicResourceManagement.Application.DTOs.ResourceDTO>

@{
    ViewData["Title"] = "Pending Approvals";
}

<h2>Resources Pending Approval</h2>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        <p>No resources pending approval.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Uploaded By</th>
                    <th>Uploaded Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.ResourceType</td>
                        <td>@item.UploadedByName</td>
                        <td>@item.UploadedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>

                            <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Approve this resource?');">
                                    Approve
                                </button>
                            </form>

                            <a asp-action="Reject" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Reject</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to Resources</a>
</div>