@model AcademicResourceManagement.Web.ViewModels.ApprovalViewModel

@{
    ViewData["Title"] = "Reject Resource";
}

<h2>Reject Resource</h2>
<hr />

<div class="alert alert-warning">
    <strong>Warning:</strong> You are about to reject the resource "<strong>@Model.Title</strong>".
    Please provide a reason for rejection.
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="RejectConfirmed" method="post">
            <input type="hidden" asp-for="ResourceId" />
            <input type="hidden" asp-for="Title" />

            <div class="form-group mb-3">
                <label asp-for="RejectionReason" class="control-label">Rejection Reason *</label>
                <textarea asp-for="RejectionReason" class="form-control" rows="5" required></textarea>
                <span asp-validation-for="RejectionReason" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Confirm Rejection" class="btn btn-danger" />
                <a asp-action="PendingApprovals" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}