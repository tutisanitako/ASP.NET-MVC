@model IEnumerable<AcademicResourceManagement.Application.DTOs.ResourceDTO>

@{
    ViewData["Title"] = "Learning Resources";
    var userRole = ViewBag.UserRole as string;
}

<div class="row">
    <div class="col-md-12">
        <h2>Learning Resources</h2>

        @if (userRole == "Lecturer")
        {
            <a asp-action="Create" class="btn btn-primary mb-3">
                <i class="bi bi-plus-circle"></i> Upload New Resource
            </a>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                <p>No resources available.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Uploaded By</th>
                            <th>Uploaded Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.ResourceType</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case AcademicResourceManagement.Domain.Enums.ResourceStatus.Draft:
                                            <span class="badge bg-secondary">Draft</span>
                                            break;
                                        case AcademicResourceManagement.Domain.Enums.ResourceStatus.PendingApproval:
                                            <span class="badge bg-warning text-dark">Pending Approval</span>
                                            break;
                                        case AcademicResourceManagement.Domain.Enums.ResourceStatus.Approved:
                                            <span class="badge bg-success">Approved</span>
                                            break;
                                        case AcademicResourceManagement.Domain.Enums.ResourceStatus.Rejected:
                                            <span class="badge bg-danger">Rejected</span>
                                            break;
                                        case AcademicResourceManagement.Domain.Enums.ResourceStatus.Published:
                                            <span class="badge bg-info">Published</span>
                                            break;
                                    }
                                </td>
                                <td>@item.UploadedByName</td>
                                <td>@item.UploadedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>