@model Lecture9.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container" style="margin-top: 20px;">
    @* Display header text from ViewData *@
    <h2>@ViewData["HeaderText"]</h2>

    @* Display current time from ViewBag *@
    <p class="text-muted">
        <small><i class="bi bi-clock"></i> Viewed at: @ViewBag.CurrentTime</small>
    </p>

    <hr />

    <div class="card">
        <div class="card-header">
            <h5>Product Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Name:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Price:</dt>
                <dd class="col-sm-9">$@Model.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Category:</dt>
                <dd class="col-sm-9">@Model.Category</dd>

                <dt class="col-sm-3">Description:</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to List</a>
    </div>
</div>